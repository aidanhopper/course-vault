# Course Resource Vault Environment Configuration

# Server
VAULT_HOST=0.0.0.0
VAULT_PORT=8000
VAULT_DATA_DIR=./data
MEDIA_DIR=./media

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/vault.db

# NFS Server IP (for compose.yml native NFS mounts)
NFS_SERVER=192.168.0.86

# User / Group IDs for NFS file permissions (defaults to 1000:1000)
PUID=1000
PGID=1000

# Ingestion Worker
MAX_CONCURRENT_DOWNLOADS=1

# AI Metadata Cleaner (Optional - if not provided, heuristic regex cleaner is used)
# AI_API_KEY=your_openai_or_openrouter_key
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Jellyfin Integration (Optional - triggers automatic library refresh upon completed import)
# JELLYFIN_URL=http://localhost:8096
# JELLYFIN_API_KEY=your_jellyfin_api_key
